rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Koleksi: menu
    // Aturan: nama 1-60 karakter, harga >= 0, sisa_porsi >= 0, tersedia boolean
    match /menu/{menuId} {
      allow read: if true;
      allow create, update: if 
        request.resource.data.nama is string &&
        request.resource.data.nama.size() >= 1 && request.resource.data.nama.size() <= 60 &&
        request.resource.data.harga is number && request.resource.data.harga >= 0 &&
        request.resource.data.sisa_porsi is number && request.resource.data.sisa_porsi >= 0 &&
        request.resource.data.tersedia is bool;
      allow delete: if true;
    }

    // 2. Koleksi: pelanggan
    // Aturan: ID nomor WA, nama 1-60 karakter, no_whatsapp 10-13 karakter, alamat 1-200 karakter
    match /pelanggan/{waId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.nama is string &&
        request.resource.data.nama.size() >= 1 && request.resource.data.nama.size() <= 60 &&
        request.resource.data.no_whatsapp is string &&
        request.resource.data.no_whatsapp.size() >= 10 && request.resource.data.no_whatsapp.size() <= 13 &&
        request.resource.data.alamat is string &&
        request.resource.data.alamat.size() >= 1 && request.resource.data.alamat.size() <= 200;
      allow delete: if true;
    }

    // 3. Koleksi: pesanan
    // Aturan: Tiga Invariant ditegakkan (jumlah_porsi >= 1, total = harga_satuan * porsi + ongkir)
    match /pesanan/{pesananId} {
      allow read: if true;
      allow create: if
        request.resource.data.pelanggan_id is string &&
        request.resource.data.nama_pelanggan is string &&
        request.resource.data.alamat_kirim is string &&
        request.resource.data.menu_id is string &&
        request.resource.data.nama_menu is string &&
        request.resource.data.harga_satuan is number && request.resource.data.harga_satuan >= 0 &&
        request.resource.data.jumlah_porsi is number && request.resource.data.jumlah_porsi >= 1 &&
        request.resource.data.ongkir is number && request.resource.data.ongkir >= 0 &&
        request.resource.data.total is number &&
        request.resource.data.total == (request.resource.data.harga_satuan * request.resource.data.jumlah_porsi + request.resource.data.ongkir) &&
        request.resource.data.status in ['menunggu_bayar', 'dibayar', 'diproses', 'selesai', 'dibatalkan'] &&
        request.resource.data.tanggal is string;
      allow update: if
        request.resource.data.status in ['menunggu_bayar', 'dibayar', 'diproses', 'selesai', 'dibatalkan'];
      allow delete: if true;
    }

    // 4. Koleksi: users (Profil Peran Pengguna: Pemilik & Staf)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
